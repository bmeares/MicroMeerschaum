menu "MicroMeerschaum"
    config MICROMEERSCHAUM_HTTPS
        bool "Enable HTTPS batch sender"
        default n
        help
            Provide the ESP-IDF client for the hosted binary ingest endpoint.
            The application provisions the receiver identity, URL and API key.
    config MICROMEERSCHAUM_SQLITE
        bool "Enable the SQLite local Pipe instance"
        default n
        help
            Store typed rows and outgoing records on a mounted LittleFS volume.
    config MICROMEERSCHAUM_NIMBLE
        bool "Enable NimBLE peer transport"
        depends on BT_NIMBLE_ENABLED && BT_NIMBLE_ROLE_CENTRAL && BT_NIMBLE_ROLE_PERIPHERAL
        default n
    config MICROMEERSCHAUM_DEVICE_SESSION
        bool "Enable the line-framed device management session"
        default n
        help
            Provide the bounded JSON session for explicitly admitted actions
            and published Pipe registrations over application-owned transports.
    config MICROMEERSCHAUM_SESSION_GATT
        bool "Enable the authenticated GATT management service"
        depends on MICROMEERSCHAUM_DEVICE_SESSION && BT_NIMBLE_ENABLED && BT_NIMBLE_ROLE_PERIPHERAL
        default n
    config MICROMEERSCHAUM_SESSION_STACK
        int "Management worker stack (bytes)"
        depends on MICROMEERSCHAUM_SESSION_GATT
        range 4096 65536
        default 8192
endmenu
