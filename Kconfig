menu "MicroMeerschaum"
    config MICROMEERSCHAUM_HTTPS
        bool "Enable HTTPS batch sender"
        default n
        help
            Provide the ESP-IDF client for the hosted binary ingest endpoint.
            The application provisions the receiver identity, URL and API key.
    config MICROMEERSCHAUM_NIMBLE
        bool "Enable NimBLE peer transport"
        depends on BT_NIMBLE_ENABLED && BT_NIMBLE_ROLE_CENTRAL && BT_NIMBLE_ROLE_PERIPHERAL
        default n
endmenu
