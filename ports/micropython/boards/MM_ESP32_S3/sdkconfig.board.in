CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="@mm_board@/partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_MICROMEERSCHAUM_HTTPS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_SSL_ALPN=y
CONFIG_MICROMEERSCHAUM_SQLITE=y
# The authenticated GATT write callback commits to LittleFS before issuing a receipt.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=16384
